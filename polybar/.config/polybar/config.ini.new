[bar/example]

width = 100%
height = 20pt
radius = 10
background = #000000
foreground = #eeaaff
line-size = 3pt
border-size = 2pt
border-color = #00000000
padding-left = 2pt
padding-right = 2pt
module-margin = 1
cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true
wm-restack = bspwm

font-0 = Zen-dots;2
font-1 = Iosevka Nerd Font;2
font-2 = Jaini Purva;2
font-3 = "DepartureMono:pixelsize=22;2"

modules-left = xworkspaces 
modules-center = date
modules-right = cpu memory wlan eth volume-down pulseaudio volume-up xkeyboard
